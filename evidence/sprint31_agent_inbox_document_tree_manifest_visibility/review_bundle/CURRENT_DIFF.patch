+
+internal fun String?.isGoogleDriveDocumentTreeUri(): Boolean {
+    val rawUri = this?.takeIf(String::isNotBlank) ?: return false
+    if (!rawUri.startsWith("content://", ignoreCase = true)) return false
+    val authority = rawUri
+        .removePrefix("content://")
+        .substringBefore('/')
+    return authority.contains("com.google.android.apps.docs", ignoreCase = true) &&
+        rawUri.contains("/tree/", ignoreCase = true)
+}
+
+internal fun String?.googleDriveDocumentTreeFolderId(): String? {
+    if (!isGoogleDriveDocumentTreeUri()) return null
+    val rawTreeDocumentId = this
+        ?.substringAfter("/tree/", missingDelimiterValue = "")
+        ?.substringBefore('/')
+        ?.takeIf(String::isNotBlank)
+        ?.urlDecodeOrSelf()
+        ?: return null
+    val docParameter = rawTreeDocumentId
+        .split(';')
+        .firstNotNullOfOrNull { segment ->
+            val trimmed = segment.trim()
+            trimmed.substringAfter("doc=", missingDelimiterValue = "")
+                .takeIf { value -> trimmed.startsWith("doc=") && value.isNotBlank() }
+        }
+    return docParameter ?: rawTreeDocumentId.takeUnless { treeId -> treeId.contains('=') }
 }

