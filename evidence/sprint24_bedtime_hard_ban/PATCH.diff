+fun bedtimeWindowIsActive(
+    enabled: Boolean,
+    startMinutes: Int,
+    endMinutes: Int,
+    nowMillis: Long,
+    zoneId: ZoneId = ZoneId.systemDefault(),
+): Boolean {
