+    var lineStart = 0
+    while (lineStart <= length) {
+        val newline = indexOf('\n', startIndex = lineStart)
+        val lineEnd = if (newline < 0) length else newline
+        action(lineStart, lineEnd)
+        if (newline < 0) {
+            return
+        }
+        lineStart = newline + 1
+    }
+}
