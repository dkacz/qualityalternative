+private fun readerMarkdownTextStyle(
+    kind: ReaderMarkdownBlockKind,
+    baseStyle: TextStyle,
+    scale: Float,
+): TextStyle {
+    return when (kind) {
+        ReaderMarkdownBlockKind.HEADING -> baseStyle.copy(
+            fontSize = (22f * scale).sp,
+            lineHeight = (29f * scale).sp,
+            fontWeight = FontWeight.SemiBold,
+        )
