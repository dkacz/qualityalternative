+@Composable
+private fun AgentInboxPriorityToggle(
+    checked: Boolean,
+    requested: Boolean,
+    onToggle: () -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    val colors = QualityAlternativeThemeTokens.colors
+    val label = when {
+        checked && requested -> "Priority accepted"
+        checked -> "Priority on"
+        requested -> "Accept priority"
+        else -> "Set priority"
+    }
+    Row(
