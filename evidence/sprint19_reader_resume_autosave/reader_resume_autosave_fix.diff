+            if (existing == null) {
+                return false
+            }
+            if (existing.isCompleted() && incoming.isUnfinished()) {
+                return true
+            }
+            if (existing.isUnfinished() && incoming.isCompleted()) {
+                return false
+            }
+            if (incoming.updatedAtMillis < existing.updatedAtMillis) {
+                return true
+            }
