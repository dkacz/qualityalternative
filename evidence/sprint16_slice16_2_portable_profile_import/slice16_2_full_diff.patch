+private fun MutableList<UnknownFieldWarning>.addUnknownKeys(
+    source: JsonObject,
+    allowed: Set<String>,
+    path: String,
+    section: String,
+) {
+    (source.keys - allowed).forEach { key ->
+        add(UnknownFieldWarning(path = "$path.$key", section = section))
+    }
+}
