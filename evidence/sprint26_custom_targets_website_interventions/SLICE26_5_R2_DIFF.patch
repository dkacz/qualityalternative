+            browserPackage = VerifiedBrowserHostAdapter.CHROME_PACKAGE,
+            browserDisplayName = "Chrome",
+            websiteRuleType = WebsiteRuleType.WILDCARD_SUBDOMAINS.name,
+            websiteRuleIncludesApex = true,
+            nowMillis = nowMillis,
